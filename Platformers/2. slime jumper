summary: character controller... slime jumps smoothly, and sideways pull movement.

goals
1. input for jumping and moving
2. smooth platform jump mechanic -> gravity, acceleration, gravity fall multiplier, velocity.
3. sideways pull movement -> 

concepts:
velocity- continuouse movement in a direction.
get_wall_normal() - tests collisions on CharacterBody2Ds. The direction at which it collides with a wall. (left, right, up, down)


extends Node2D

@export var player: CharacterBody2D
@export var Max_Jump: int = 270
@export var gravity: int = 500
@export var gravity_fall_multiplier: int = 6
@export var gravity_acceleration: float = 0.2
@export var horizontal_pull: float = 0
@export var pull_speed: int = 1600
@export var pull_acceleration:float = 0.6

var current_gravity_acceleration: float = 0
var current_pull_acceleration: float = 0

func _physics_process(delta: float) -> void:
	_handle_pull(delta)
	_gravity(delta)
	_jump()
	player.move_and_slide()
	pass

func _handle_pull(delta):
	if Input.is_action_just_released("left"):
		current_pull_acceleration = 0
		horizontal_pull = -pull_speed
	elif Input.is_action_just_released("right"):
		current_pull_acceleration = 0
		horizontal_pull = +pull_speed
	
	elif player.is_on_wall(): 
		if player.get_wall_normal().x >= 0:
			horizontal_pull = 0
			current_pull_acceleration = 0
		elif player.get_wall_normal().x <= 0:
			horizontal_pull = 0
			current_pull_acceleration = 0
	
	player.velocity.x = horizontal_pull * current_pull_acceleration * delta
	
	
	if current_pull_acceleration < 10:
		current_pull_acceleration += pull_acceleration
	
	
	

func _gravity(delta):
	
	if player.velocity.y > 0.0:
		player.velocity.y += gravity * gravity_fall_multiplier * current_gravity_acceleration * delta
		if current_gravity_acceleration < 3:
			current_gravity_acceleration += gravity_acceleration
	else:
		player.velocity.y += gravity * delta

	
func _jump() -> void:
	if !Input.is_action_just_pressed("up"): return
	if player.is_on_floor():
		player.velocity.y = -Max_Jump
		current_gravity_acceleration = 0
	

