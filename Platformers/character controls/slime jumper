summary: character controller... slime can jump, move left and right by sliding.

Nodes needed: uses 2 timers, characterBody2D

goals
1. input for jumping and moving
2. smooth platform jump mechanic -> gravity, acceleration, gravity fall multiplier, velocity, coyote jump, input buffer.
3. sideways pull movement -> horizontal_pull, pull_speed, pull_acceleration

concepts:
velocity- continuouse movement in a direction.
get_wall_normal() - tests wall collisions on CharacterBody2Ds.
acceleration, gravity, coyote jump, input buffer, is_on_floor()

extends Node2D

@export var player: CharacterBody2D
@export var Max_Jump: int = 760
@export var gravity: int = 900
@export var gravity_fall_multiplier: int = 8
@export var gravity_acceleration: float = 0.2
@export var horizontal_pull: float = 0
@export var pull_speed: int = 2200
@export var pull_acceleration:float = 0.6

@onready var coyote_timer = $"../coyote_timer"
@onready var input_buffer = $"../input_buffer"

var jump_cut_off_value: float = 0.4
var current_gravity_acceleration: float = 0
var current_pull_acceleration: float = 0

func _physics_process(delta: float) -> void:
	_handle_pull(delta)
	_gravity(delta)
	_jumping(delta)
	player.move_and_slide()
	pass

func _handle_pull(delta):
	if Input.is_action_just_pressed("left") and !horizontal_pull == -pull_speed:
		current_pull_acceleration = 0
		horizontal_pull = -pull_speed
	elif Input.is_action_just_pressed("right") and !horizontal_pull == +pull_speed:
		current_pull_acceleration = 0
		horizontal_pull = +pull_speed
		
	elif player.is_on_wall() and !Input.is_anything_pressed():
		"""wall smashing stops player movement"""
		if player.get_wall_normal().x >= 0:
			horizontal_pull = 0
			current_pull_acceleration = 0
		elif player.get_wall_normal().x <= 0:
			horizontal_pull = 0
			current_pull_acceleration = 0
	
	elif Input.is_action_just_pressed("down"):
		horizontal_pull = 0
		current_pull_acceleration = 0
	
	player.velocity.x = horizontal_pull * current_pull_acceleration * delta
	
	if current_pull_acceleration < 10:
		current_pull_acceleration += pull_acceleration
	

func _gravity(delta):
	
	if player.velocity.y > 0.0:
		player.velocity.y += gravity * gravity_fall_multiplier * current_gravity_acceleration * delta
		if current_gravity_acceleration < 3:
			current_gravity_acceleration += gravity_acceleration
	else:
		player.velocity.y += gravity * delta

func _jumping(delta):
	if Input.is_action_just_pressed("up"):
		input_buffer.start()

	
	if player.is_on_floor():
		coyote_timer.start()
	
	if !coyote_timer.is_stopped() and !input_buffer.is_stopped():
		_make_jump(delta)
	if Input.is_action_just_released("up"):
		player.velocity.y *= jump_cut_off_value
	#test for when jump key is held and how long.
	# set jump height depending on how long its held.
	
func _make_jump(delta):
	player.velocity.y = -Max_Jump * delta * 30
	current_gravity_acceleration = 0
	coyote_timer.stop()
	input_buffer.stop()
